<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Identifier</key>
    <string>com.github.BIXALBaileyWalters.install.vscodium</string>
    <key>Input</key>
    <dict>
    </dict>
    <key>MinimumVersion</key>
    <string>0.5.0</string>
    <key>ParentRecipe</key>
	<string>com.github.BIXALBaileyWalters.download.vscodium</string>
    <key>Process</key>
    <array>
        <dict>
            <key>Processor</key>
            <string>com.github.BIXALbaileywalters.extraprocessors/GetUserHome</string>
        </dict>
        <dict>
            <key>Processor</key>
            <string>EndOfCheckPhase</string>
        </dict>
        <dict>
            <key>Processor</key>
            <string>InstallFromDMG</string>
            <key>Arguments</key>
            <dict>
                <key>dmg_path</key>
                <string>%pathname%</string>
                <key>items_to_copy</key>
                <array>
                  <dict>
                    <key>source_item</key>
                    <string>%APPNAME%</string>
                    <key>destination_path</key>
                    <string>%user_home%/Applications</string>
                    <key>user</key>
                    <string>%current_user%</string>
                    <key>group</key>
                    <string>staff</string>
                    <key>mode</key>
                    <string>0755</string>
                  </dict>
                </array>
            </dict>
        </dict>
        <dict>
            <key>Processor</key>
            <string>com.github.BIXALbaileywalters.extraprocessors/LinkUserApp</string>
            <key>Arguments</key>
            <dict>
                <key>user_home</key>
                <string>%user_home%</string>
                <key>app_name</key>
                <string>%APPNAME%</string>
            </dict>
        </dict>
    </array>
</dict>
</plist>